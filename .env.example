# AICTE Security Deposit / FDR Portal - Environment Configuration
APP_NAME="AICTE Security Deposit / FDR Portal"
APP_ENV=development
DEBUG=True

# Database (Default: local SQLite; for PostgreSQL use postgresql://user:password@localhost:5432/fdr_portal)
DATABASE_URL=sqlite:///./fdr_portal.db

# Authentication / JWT
SECRET_KEY=super-secret-aicte-portal-key-26265-prototype-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Document Storage & Security Limits
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=15
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]

# Proximity Reminder Windows & Timezone
REMINDER_WINDOWS_DAYS=[30,15,7,0]
APP_TIMEZONE=Asia/Kolkata

# Core Banking Adapter Mode (DEMO or LIVE)
BANK_VERIFIER_MODE=DEMO

# Logging
LOG_LEVEL=INFO
